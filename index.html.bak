  <!-- JAVASCRIPT SINGLE PAGE ROUTER & INTERACTIVE LOGIC -->
  <script>
    // 1. Live UTC Clock
    function updateClock() {
      const now = new Date();
      const utcString = now.toUTCString().split(' ')[4] + ' UTC';
      document.getElementById('live-clock').textContent = utcString;
    }
    setInterval(updateClock, 1000);
    updateClock();

    // 2. Clean SPA Hash Router Logic
    const pageViews = {
      home: document.getElementById('page-home'),
      about: document.getElementById('page-about'),
      spares: document.getElementById('page-spares'),
      services: document.getElementById('page-services'),
      sectors: document.getElementById('page-sectors'),
      quality: document.getElementById('page-quality'),
      contact: document.getElementById('page-contact')
    };

    const breadcrumbContainer = document.getElementById('breadcrumb-container');
    const breadcrumbCurrent = document.getElementById('breadcrumb-current-page');

    const pageTitles = {
      home: 'Precision ACHE Spares & Rapid Field Engineering',
      about: 'About AFTS & Chennai Facilities',
      spares: 'Spares & Components Catalog',
      services: 'Core Engineering Services',
      sectors: 'Industry Sectors & Case Studies',
      quality: 'Quality Standards & AVL Verification',
      contact: 'Contact & Instant RFQ Hub'
    };

    function navigateToPage(pageId) {
      if (!pageViews[pageId]) pageId = 'home';

      // Hide all pages & set active class
      Object.keys(pageViews).forEach(id => {
        if (pageViews[id]) pageViews[id].classList.remove('active');
      });
      pageViews[pageId].classList.add('active');

      // Update Desktop Nav Active highlight
      document.querySelectorAll('#desktop-nav .nav-link').forEach(link => {
        if (link.getAttribute('data-page') === pageId) {
          link.classList.add('text-brand-orange', 'font-semibold', 'active');
          link.classList.remove('text-slate-300');
        } else {
          link.classList.remove('text-brand-orange', 'font-semibold', 'active');
          link.classList.add('text-slate-300');
        }
      });

      // Update Breadcrumbs
      if (pageId === 'home') {
        breadcrumbContainer.classList.add('hidden');
      } else {
        breadcrumbContainer.classList.remove('hidden');
        breadcrumbCurrent.textContent = pageTitles[pageId] || pageId.toUpperCase();
      }

      // Scroll top
      window.scrollTo({ top: 0, behavior: 'smooth' });

      // Close mobile drawer if open
      document.getElementById('mobile-menu').classList.add('hidden');
      document.getElementById('menu-icon-open').classList.remove('hidden');
      document.getElementById('menu-icon-close').classList.add('hidden');
    }

    function handleHashChange() {
      const hash = window.location.hash.replace('#', '') || 'home';
      navigateToPage(hash);
    }

    window.addEventListener('hashchange', handleHashChange);
    handleHashChange();

    document.querySelectorAll('.nav-link').forEach(link => {
      link.addEventListener('click', (e) => {
        const pageId = link.getAttribute('data-page');
        if (pageId) {
          window.location.hash = pageId;
        }
      });
    });

    // 3. Mobile Navigation Menu Toggle
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIconOpen = document.getElementById('menu-icon-open');
    const menuIconClose = document.getElementById('menu-icon-close');

    mobileMenuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
      menuIconOpen.classList.toggle('hidden');
      menuIconClose.classList.toggle('hidden');
    });

    // 4. Quick Tube Spec Interactive Finder
    const quickSpecBtn = document.getElementById('quick-spec-btn');
    const quickSpecResult = document.getElementById('quick-spec-result');
    const specOutputText = document.getElementById('spec-output-text');

    if (quickSpecBtn) {
      quickSpecBtn.addEventListener('click', () => {
        const mat = document.getElementById('quick-material').value;
        const fin = document.getElementById('quick-fintype').value;
        specOutputText.textContent = `${fin} on ${mat}`;
        quickSpecResult.classList.remove('hidden');
      });
    }

    // 5. Catalog Filter & Search Engine
    const catalogBtns = document.querySelectorAll('.catalog-tab-btn');
    const catalogItems = document.querySelectorAll('.catalog-item');
    const catalogSearchInput = document.getElementById('catalog-search-input');

    function filterCatalog() {
      const activeTab = document.querySelector('.catalog-tab-btn.active').getAttribute('data-cat');
      const searchQuery = (catalogSearchInput ? catalogSearchInput.value : '').toLowerCase().trim();

      catalogItems.forEach(item => {
        const cat = item.getAttribute('data-cat');
        const keywords = item.getAttribute('data-keywords').toLowerCase();
        const matchesCat = (activeTab === 'all' || cat === activeTab);
        const matchesSearch = (searchQuery === '' || keywords.includes(searchQuery));

        if (matchesCat && matchesSearch) {
          item.style.display = 'flex';
        } else {
          item.style.display = 'none';
        }
      });
    }

    catalogBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        catalogBtns.forEach(b => {
          b.classList.remove('active', 'bg-brand-orange', 'text-white');
          b.classList.add('bg-slate-800', 'text-slate-300');
        });
        btn.classList.add('active', 'bg-brand-orange', 'text-white');
        btn.classList.remove('bg-slate-800', 'text-slate-300');
        filterCatalog();
      });
    });

    if (catalogSearchInput) {
      catalogSearchInput.addEventListener('input', filterCatalog);
    }

    // 6. Downtime ROI Calculator Logic
    const revSlider = document.getElementById('calc-revenue-slider');
    const oemSlider = document.getElementById('calc-oem-slider');
    const aftsSlider = document.getElementById('calc-afts-slider');

    function updateCalculator() {
      if (!revSlider) return;
      const rev = parseInt(revSlider.value);
      const oemDays = parseInt(oemSlider.value);
      const aftsDays = parseInt(aftsSlider.value);

      document.getElementById('calc-revenue-label').textContent = `$${rev.toLocaleString()} / day`;
      document.getElementById('calc-oem-label').textContent = `${oemDays} Days`;
      document.getElementById('calc-afts-label').textContent = `${aftsDays} Days`;

      const savedDays = Math.max(0, oemDays - aftsDays);
      const savings = savedDays * rev;

      document.getElementById('calc-result-savings').textContent = `$${savings.toLocaleString()}`;
      document.getElementById('calc-result-days').textContent = `${savedDays} Days`;
    }

    if (revSlider) {
      [revSlider, oemSlider, aftsSlider].forEach(s => s.addEventListener('input', updateCalculator));
      updateCalculator();
    }

    // 7. Finned Tube Surface Area Calculator #2
    function updateCalc2() {
      const od = parseFloat(document.getElementById('calc2-od').value);
      const fh = parseFloat(document.getElementById('calc2-fin-height').value);
      const fpi = parseFloat(document.getElementById('calc2-fpi').value);

      const ratio = ((Math.PI * (od + 2 * fh) * 2 * fh * (fpi * 39.37) / 1000) / (Math.PI * od / 1000)).toFixed(1);
      const resEl = document.getElementById('calc2-result-ratio');
      if (resEl) resEl.textContent = `${ratio}x`;
    }

    ['calc2-od', 'calc2-fin-height', 'calc2-fpi'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.addEventListener('change', updateCalc2);
    });

    // 8. AVL Pre-qualification Search
    const avlBtn = document.getElementById('avl-search-btn');
    const avlInput = document.getElementById('avl-search-input');
    const avlResult = document.getElementById('avl-search-result');
    const avlCompany = document.getElementById('avl-target-company');

    if (avlBtn) {
      avlBtn.addEventListener('click', () => {
        const query = avlInput.value.trim();
        if (query.length > 0) {
          avlCompany.textContent = query.toUpperCase();
          avlResult.classList.remove('hidden');
        }
      });
    }

    // 9. RFQ Form Submit Handler with Ref ID
    const rfqForm = document.getElementById('rfq-form');
    const rfqSuccess = document.getElementById('rfq-success-toast');
    const rfqRefId = document.getElementById('rfq-ref-id');

    if (rfqForm) {
      rfqForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const randomId = Math.floor(1000 + Math.random() * 9000);
        rfqRefId.textContent = `AFTS-RFQ-2025-${randomId}`;
        rfqSuccess.classList.remove('hidden');
        rfqForm.reset();
      });
    }

    // 10. Spec Modal Preview Handler
    const specModal = document.getElementById('spec-modal');
    const modalTitle = document.getElementById('modal-product-title');
    const closeModalBtn = document.getElementById('close-modal-btn');

    document.querySelectorAll('.open-spec-modal').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const prod = btn.getAttribute('data-product');
        if (modalTitle) modalTitle.textContent = prod;
        if (specModal) specModal.classList.remove('hidden');
      });
    });

    if (closeModalBtn) {
      closeModalBtn.addEventListener('click', () => {
        specModal.classList.add('hidden');
      });
    }

    if (specModal) {
      specModal.addEventListener('click', (e) => {
        if (e.target === specModal) specModal.classList.add('hidden');
      });
    }

    // 11. Global Search Modal (Ctrl+K)
    const searchTrigger = document.getElementById('global-search-trigger');
    const searchModal = document.getElementById('global-search-modal');
    const closeSearchBtn = document.getElementById('close-search-modal');
    const searchInput = document.getElementById('global-search-input');
    const searchResults = document.getElementById('global-search-results');

    const searchItems = [
      { title: 'Extruded Aluminum Finned Tubes', page: 'spares', desc: 'Continuous aluminum sleeve cold-extruded over inner tube core up to 300°C.' },
      { title: 'Embedded G-Fin Heavy Duty Tubes', page: 'spares', desc: 'Grooved aluminum fin strip for high temperature up to 400°C.' },
      { title: 'Forged Shoulder Plugs & Header Assemblies', page: 'spares', desc: 'CNC machined UNF/NPT SA105 and SA350 LF2 header plugs.' },
      { title: 'Emergency Tube Plugging Service', page: 'services', desc: '< 24h rapid field isolation of leaking finned tubes.' },
      { title: 'Turnaround Field Retubing', page: 'services', desc: 'On-site tube replacement, pneumatic expanding, and hydrotesting.' },
      { title: 'Refinery Downtime Loss ROI Calculator', page: 'home', desc: 'Calculate money saved by AFTS emergency dispatch.' },
      { title: 'Quality Standards & AVL Checker', page: 'quality', desc: 'Verify prequalification for Reliance, IOCL, BPCL, SABIC.' },
      { title: 'Chennai Engineering Facility & Headquarters', page: 'about', desc: 'Plot No. 305B, Kovur, Poonamallee, Chennai - 600128.' }
    ];

    function toggleSearchModal() {
      searchModal.classList.toggle('hidden');
      if (!searchModal.classList.contains('hidden')) {
        searchInput.focus();
        renderSearchResults('');
      }
    }

    function renderSearchResults(query) {
      const q = query.toLowerCase().trim();
      const filtered = searchItems.filter(item => item.title.toLowerCase().includes(q) || item.desc.toLowerCase().includes(q));

      if (filtered.length === 0) {
        searchResults.innerHTML = `<div class="p-4 text-slate-500 text-center">No matching technical records found.</div>`;
        return;
      }

      searchResults.innerHTML = filtered.map(item => `
        <div class="p-3 bg-slate-950 border border-slate-800 rounded-lg hover:border-brand-orange cursor-pointer transition-colors" onclick="window.location.hash='${item.page}'; toggleSearchModal();">
          <div class="text-brand-orange font-bold text-sm">${item.title}</div>
          <div class="text-slate-400 text-xs">${item.desc}</div>
        </div>
      `).join('');
    }

    if (searchTrigger) searchTrigger.addEventListener('click', toggleSearchModal);
    if (closeSearchBtn) closeSearchBtn.addEventListener('click', toggleSearchModal);

    window.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        toggleSearchModal();
      }
      if (e.key === 'Escape' && !searchModal.classList.contains('hidden')) {
        toggleSearchModal();
      }
    });

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        renderSearchResults(e.target.value);
      });
    }
  </script>

</body>
</html>