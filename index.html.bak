<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Air-Fin Technical Services Pvt Ltd | Precision ACHE Spares & Rapid Field Engineering</title>
  <meta name="description" content="Air-Fin Technical Services Pvt Ltd (AFTS) - Premier engineering specialists in Air-Cooled Heat Exchanger (ACHE) spares, emergency tube plugging, field retubing, ASME header boxes, and AVL-approved plant turnaround solutions." />
  <meta name="keywords" content="ACHE spares, finned tubes, emergency tube plugging, field retubing, air cooled heat exchanger, ASME headers, shoulder plugs, Kovur Chennai, AFTS" />
  
  <!-- Preconnect & Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet"/>

  <!-- Tailwind CSS CDN with Custom Extended Config -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            brand: {
              orange: "#FF5722",
              "orange-hover": "#E64A19",
              "orange-light": "#FFF3E0",
              blue: "#0284C7",
              "blue-dark": "#0369A1",
              "blue-light": "#E0F2FE",
              dark: "#0F172A",
              "dark-deep": "#070C16",
              card: "#1E293B",
              "card-border": "#334155",
              slate: "#475569",
              light: "#F8FAFC",
              emerald: "#10B981",
              "emerald-light": "#D1FAE5"
            }
          },
          fontFamily: {
            sans: ["Plus Jakarta Sans", "sans-serif"],
            display: ["Space Grotesk", "sans-serif"],
            mono: ["JetBrains Mono", "monospace"]
          },
          boxShadow: {
            'glow-orange': '0 0 25px rgba(255, 87, 34, 0.35)',
            'glow-blue': '0 0 25px rgba(2, 132, 199, 0.35)',
            'glass': '0 8px 32px 0 rgba(0, 0, 0, 0.37)'
          },
          backgroundImage: {
            'gradient-radial': 'radial-gradient(var(--tw-gradient-stops))',
            'grid-pattern': "linear-gradient(to right, rgba(255,255,255,0.05) 1px, transparent 1px), linear-gradient(to bottom, rgba(255,255,255,0.05) 1px, transparent 1px)"
          }
        }
      }
    };
  </script>

  <style>
    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #0f172a;
    }
    ::-webkit-scrollbar-thumb {
      background: #334155;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #ff5722;
    }

    /* Glassmorphism utility */
    .glass-dark {
      background: rgba(15, 23, 42, 0.85);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .glass-card-hover {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .glass-card-hover:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5), 0 0 20px rgba(255, 87, 34, 0.2);
      border-color: rgba(255, 87, 34, 0.4);
    }

    /* Tech Animated Pulse */
    @keyframes pulse-slow {
      0%, 100% { opacity: 0.3; transform: scale(1); }
      50% { opacity: 0.6; transform: scale(1.05); }
    }
    .animate-pulse-slow {
      animation: pulse-slow 8s infinite ease-in-out;
    }

    /* Range slider custom styling */
    input[type=range]::-webkit-slider-thumb {
      -webkit-appearance: none;
      height: 20px;
      width: 20px;
      border-radius: 50%;
      background: #FF5722;
      cursor: pointer;
      box-shadow: 0 0 10px rgba(255,87,34,0.5);
    }

    /* Multi-page Routing Animations */
    .page-view {
      display: none;
      opacity: 0;
      transition: opacity 0.3s ease-in-out;
    }
    .page-view.active {
      display: block;
      opacity: 1;
    }

    /* Print styling for Spec sheets */
    @media print {
      body * {
        visibility: hidden;
      }
      #spec-modal-content, #spec-modal-content * {
        visibility: visible;
      }
      #spec-modal-content {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        color: #000;
        background: #fff;
      }
    }
  </style>
</head>

<body class="bg-brand-dark-deep text-slate-100 font-sans antialiased selection:bg-brand-orange selection:text-white overflow-x-hidden">

  <!-- TOP RAPID DISPATCH & METRICS INFOBAR -->
  <div class="bg-brand-dark border-b border-slate-800 text-xs py-2.5 px-4 lg:px-12 text-slate-300 font-mono sticky top-0 z-50 shadow-md">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-2">
      <div class="flex items-center gap-3">
        <span class="flex h-2.5 w-2.5 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
        </span>
        <span class="tracking-wider uppercase font-semibold text-emerald-400">ACHE Field Specialists</span>
        <span class="text-slate-600">|</span>
        <span class="hidden sm:inline text-slate-300">&lt; 24h Emergency Plant Turnaround &amp; Retubing Dispatch</span>
      </div>

      <div class="flex items-center gap-6">
        <!-- Live Clock -->
        <div class="hidden lg:flex items-center gap-2 text-slate-400">
          <span class="material-symbols-outlined text-[14px] text-brand-orange">schedule</span>
          <span id="live-clock">UTC: --:--:--</span>
        </div>

        <!-- Global Search Trigger -->
        <button id="global-search-trigger" class="hidden sm:flex items-center gap-2 bg-slate-800 hover:bg-slate-700 px-3 py-1 rounded-md text-slate-300 border border-slate-700 transition-colors">
          <span class="material-symbols-outlined text-[14px]">search</span>
          <span>Search Specs</span>
          <kbd class="bg-slate-900 px-1.5 py-0.5 rounded text-[10px] text-slate-400 border border-slate-700">Ctrl+K</kbd>
        </button>

        <div class="flex items-center gap-4 text-xs font-sans">
          <a href="tel:+917695828840" class="flex items-center gap-1.5 text-slate-200 hover:text-brand-orange transition-colors">
            <span class="material-symbols-outlined text-brand-orange text-[14px]">call</span>
            <span class="font-semibold">+91 7695828840</span>
          </a>
          <a href="mailto:afts@airfintec.com" class="hidden sm:flex items-center gap-1.5 text-slate-200 hover:text-brand-orange transition-colors">
            <span class="material-symbols-outlined text-brand-blue text-[14px]">mail</span>
            <span>afts@airfintec.com</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- CLEAN & ELEGANT NAVIGATION BAR -->
  <header class="sticky top-[37px] z-40 glass-dark border-b border-slate-800/80 transition-all duration-300" id="main-header">
    <div class="max-w-7xl mx-auto px-4 lg:px-12 h-20 flex items-center justify-between gap-4">
      
      <!-- Brand Logo -->
      <a href="#home" class="nav-link flex items-center gap-3 group">
        <div class="h-11 w-11 rounded-xl bg-gradient-to-br from-brand-orange via-amber-500 to-brand-blue p-0.5 shadow-glow-orange group-hover:scale-105 transition-transform duration-300">
          <div class="w-full h-full bg-brand-dark rounded-[10px] flex items-center justify-center p-1">
            <img src="Air-Fin Tech logo.png" alt="Air-Fin Tech" class="h-7 w-auto object-contain" onError="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
            <span class="material-symbols-outlined text-brand-orange text-2xl hidden">mode_fan</span>
          </div>
        </div>
        <div class="flex flex-col">
          <span class="font-display font-extrabold text-xl tracking-tight text-white group-hover:text-brand-orange transition-colors flex items-center gap-1.5">
            Air-Fin Tech
            <span class="bg-brand-orange/20 text-brand-orange border border-brand-orange/30 text-[9px] font-mono px-1.5 py-0.2 rounded font-bold uppercase">PVT LTD</span>
          </span>
          <span class="font-mono text-[10px] tracking-widest text-brand-blue uppercase font-medium">Technical Services • Chennai</span>
        </div>
      </a>

      <!-- CLEAN & SIMPLE DESKTOP NAVBAR OPTIONS -->
      <nav class="hidden md:flex items-center gap-2 text-sm font-medium text-slate-300" id="desktop-nav">
        <a href="#home" class="nav-link px-4 py-2 rounded-xl hover:text-white hover:bg-slate-800/60 transition-all active text-brand-orange font-semibold" data-page="home">Home</a>
        <a href="#about" class="nav-link px-4 py-2 rounded-xl hover:text-white hover:bg-slate-800/60 transition-all" data-page="about">About Us</a>
        <a href="#spares" class="nav-link px-4 py-2 rounded-xl hover:text-white hover:bg-slate-800/60 transition-all" data-page="spares">Spares Catalog</a>
        <a href="#services" class="nav-link px-4 py-2 rounded-xl hover:text-white hover:bg-slate-800/60 transition-all" data-page="services">Core Services</a>
        <a href="#sectors" class="nav-link px-4 py-2 rounded-xl hover:text-white hover:bg-slate-800/60 transition-all" data-page="sectors">Sectors &amp; Cases</a>
        <a href="#quality" class="nav-link px-4 py-2 rounded-xl hover:text-white hover:bg-slate-800/60 transition-all" data-page="quality">Quality &amp; AVL</a>
        <a href="#contact" class="nav-link px-4 py-2 rounded-xl hover:text-white hover:bg-slate-800/60 transition-all" data-page="contact">Contact &amp; RFQ</a>
      </nav>

      <!-- Header Action Buttons -->
      <div class="flex items-center gap-3">
        <a href="#contact" class="nav-link hidden sm:inline-flex items-center gap-2 bg-gradient-to-r from-brand-orange to-amber-600 hover:from-brand-orange-hover hover:to-amber-700 text-white font-display text-xs uppercase font-bold tracking-wider px-5 py-3 rounded-xl shadow-glow-orange transition-all duration-300 hover:scale-105" data-page="contact">
          <span class="material-symbols-outlined text-[16px]">bolt</span>
          <span>Request RFQ</span>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button id="mobile-menu-btn" class="md:hidden p-2.5 rounded-lg bg-slate-800 text-slate-200 hover:text-white focus:outline-none" aria-label="Toggle navigation menu">
          <span class="material-symbols-outlined text-2xl block" id="menu-icon-open">menu</span>
          <span class="material-symbols-outlined text-2xl hidden" id="menu-icon-close">close</span>
        </button>
      </div>

    </div>

    <!-- Mobile Navigation Drawer -->
    <div id="mobile-menu" class="hidden md:hidden bg-brand-dark/95 backdrop-blur-2xl border-b border-slate-800 px-6 py-6 space-y-3 font-display">
      <a href="#home" class="mobile-nav-link nav-link block text-base font-semibold text-white hover:text-brand-orange py-2" data-page="home">Home Page</a>
      <a href="#about" class="mobile-nav-link nav-link block text-base font-medium text-slate-300 hover:text-brand-orange py-2" data-page="about">About AFTS &amp; Facilities</a>
      <a href="#spares" class="mobile-nav-link nav-link block text-base font-medium text-slate-300 hover:text-brand-orange py-2" data-page="spares">Spares Catalog</a>
      <a href="#services" class="mobile-nav-link nav-link block text-base font-medium text-slate-300 hover:text-brand-orange py-2" data-page="services">Core Engineering Services</a>
      <a href="#sectors" class="mobile-nav-link nav-link block text-base font-medium text-slate-300 hover:text-brand-orange py-2" data-page="sectors">Sectors &amp; Case Studies</a>
      <a href="#quality" class="mobile-nav-link nav-link block text-base font-medium text-slate-300 hover:text-brand-orange py-2" data-page="quality">Quality Standards &amp; AVL</a>
      <a href="#contact" class="mobile-nav-link nav-link block text-base font-medium text-slate-300 hover:text-brand-orange py-2" data-page="contact">Direct Contact &amp; RFQ</a>
      
      <div class="pt-4 border-t border-slate-800 flex flex-col gap-3">
        <a href="tel:+917695828840" class="flex items-center justify-center gap-2 bg-slate-800 text-slate-200 py-3 rounded-xl font-mono text-xs uppercase font-semibold">
          <span class="material-symbols-outlined text-brand-orange text-sm">call</span>
          <span>Call 24/7 Hotline</span>
        </a>
        <a href="https://wa.me/917695828840" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 bg-brand-emerald text-white py-3 rounded-xl font-mono text-xs uppercase font-semibold">
          <span class="material-symbols-outlined text-sm">chat</span>
          <span>WhatsApp Duty Engineer</span>
        </a>
      </div>
    </div>
  </header>

  <!-- BREADCRUMB BAR (Sub-page Header) -->
  <div id="breadcrumb-container" class="bg-slate-900/90 border-b border-slate-800 py-2.5 px-4 lg:px-12 text-xs font-mono text-slate-400 hidden">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-2">
        <a href="#home" class="nav-link text-slate-400 hover:text-brand-orange flex items-center gap-1" data-page="home">
          <span class="material-symbols-outlined text-sm">home</span>
          <span>Home</span>
        </a>
        <span class="text-slate-600">/</span>
        <span id="breadcrumb-current-page" class="text-brand-orange font-semibold">Page Title</span>
      </div>
      <div class="hidden sm:flex items-center gap-4 text-[11px] text-slate-500">
        <span>ISO 9001:2015 Certified</span>
        <span>•</span>
        <span>ASME Sec VIII &amp; API 661 Compliant</span>
      </div>
    </div>
  </div>

  <!-- MAIN CONTENT VIEWS CONTAINER -->
  <main>

    <!-- =================================================================== -->
    <!-- PAGE 1: HOME PAGE VIEW -->
    <!-- =================================================================== -->
    <div id="page-home" class="page-view active">
      
      <!-- HERO SECTION -->
      <section class="relative min-h-[90vh] flex items-center bg-brand-dark-deep overflow-hidden pt-12 pb-24">
        <div class="absolute inset-0 bg-grid-pattern opacity-10 pointer-events-none"></div>
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[650px] h-[650px] bg-brand-orange/15 rounded-full blur-[140px] pointer-events-none animate-pulse-slow"></div>
        <div class="absolute bottom-10 right-10 w-[550px] h-[550px] bg-brand-blue/15 rounded-full blur-[140px] pointer-events-none"></div>

        <div class="relative max-w-7xl mx-auto px-4 lg:px-12 w-full grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
          
          <!-- Left Hero Copy -->
          <div class="lg:col-span-7 space-y-8">
            
            <div class="inline-flex items-center gap-3 bg-brand-dark border border-brand-orange/40 px-4 py-2 rounded-full shadow-glow-orange">
              <span class="flex h-2.5 w-2.5 relative">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-orange opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-brand-orange"></span>
              </span>
              <span class="font-mono text-xs text-slate-200 tracking-wider uppercase font-semibold">
                Emergency Turnaround: <span class="text-brand-orange font-bold">&lt; 24h Global Dispatch</span>
              </span>
            </div>

            <h1 class="font-display font-extrabold text-4xl sm:text-5xl lg:text-6xl text-white tracking-tight leading-[1.1]">
              Precision ACHE Spares &amp; Rapid <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-orange via-amber-400 to-brand-blue">Field Retubing Engineering</span>
            </h1>

            <p class="text-slate-300 text-base sm:text-lg max-w-2xl leading-relaxed font-normal">
              Eradicating refinery and petrochemical plant downtime. Air-Fin Technical Services delivers ASME &amp; API 661 compliant Air-Cooled Heat Exchanger finned tubes, header boxes, emergency tube plugging, and turnkey field retubing within industry-fastest turnaround schedules.
            </p>

            <div class="space-y-6 pt-2">
              <div class="flex flex-wrap items-center gap-4">
                <a href="#contact" class="nav-link inline-flex items-center gap-3 bg-gradient-to-r from-brand-orange to-amber-600 hover:from-brand-orange-hover hover:to-amber-700 text-white font-display text-sm uppercase font-bold tracking-wider px-8 py-4 rounded-xl shadow-glow-orange transition-all duration-300 hover:scale-105" data-page="contact">
                  <span>Request Instant Quote</span>
                  <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
                </a>

                <a href="#spares" class="nav-link inline-flex items-center gap-2 bg-slate-800/80 hover:bg-slate-700 text-slate-200 border border-slate-700 font-display text-sm uppercase font-bold tracking-wider px-8 py-4 rounded-xl backdrop-blur-md transition-all duration-300" data-page="spares">
                  <span class="material-symbols-outlined text-[18px]">inventory_2</span>
                  <span>Explore Spares Catalog</span>
                </a>
              </div>

              <!-- Quick Tube Spec Interactive Search Widget -->
              <div class="glass-dark p-5 rounded-2xl border border-slate-800 shadow-glass max-w-2xl space-y-3">
                <div class="flex items-center justify-between text-xs font-mono text-slate-400 uppercase tracking-wider">
                  <span class="flex items-center gap-1.5 text-brand-orange">
                    <span class="material-symbols-outlined text-sm">tune</span>
                    Interactive Tube Spec Builder
                  </span>
                  <span>Instant Parameter Check</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs">
                  <div>
                    <label class="block text-slate-400 mb-1 font-mono">Base Tube Alloy</label>
                    <select id="quick-material" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-slate-200 focus:outline-none focus:border-brand-orange">
                      <option value="Carbon Steel SA214 / SA179">Carbon Steel SA214 / SA179</option>
                      <option value="Stainless Steel 316L / 304L">Stainless Steel 316L / 304L</option>
                      <option value="Duplex 2205 / Super Duplex">Duplex 2205 / Super Duplex</option>
                      <option value="Copper Nickel CuNi 70/30">Copper Nickel CuNi 70/30</option>
                    </select>
                  </div>
                  <div>
                    <label class="block text-slate-400 mb-1 font-mono">Fin Type</label>
                    <select id="quick-fintype" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-slate-200 focus:outline-none focus:border-brand-orange">
                      <option value="Extruded Aluminum High Duty">Extruded Aluminum High Duty</option>
                      <option value="Embedded G-Type (High Temp)">Embedded G-Type (High Temp)</option>
                      <option value="L-Footed / Double L Wrap">L-Footed / Double L Wrap</option>
                      <option value="Bimetallic Tension Fin">Bimetallic Tension Fin</option>
                    </select>
                  </div>
                  <div class="flex items-end">
                    <button id="quick-spec-btn" class="w-full bg-brand-blue hover:bg-brand-blue-dark text-white font-mono text-xs uppercase font-bold py-2 px-3 rounded-lg transition-colors flex items-center justify-center gap-1">
                      <span>Inspect Spec</span>
                      <span class="material-symbols-outlined text-xs">search</span>
                    </button>
                  </div>
                </div>

                <div id="quick-spec-result" class="hidden text-xs bg-slate-900/90 p-3 rounded-lg border border-brand-blue/40 text-slate-300 font-mono flex items-center justify-between">
                  <span>Selected: <strong id="spec-output-text" class="text-brand-orange">--</strong></span>
                  <a href="#contact" class="nav-link text-brand-blue hover:underline font-bold flex items-center gap-1" data-page="contact">
                    RFQ This Spec <span class="material-symbols-outlined text-xs">arrow_forward</span>
                  </a>
                </div>
              </div>
            </div>

          </div>

          <!-- Right Hero Visual Card -->
          <div class="lg:col-span-5 relative">
            <div class="relative rounded-3xl overflow-hidden glass-dark border border-slate-700/80 p-3 shadow-2xl">
              <div class="relative rounded-2xl overflow-hidden aspect-[4/3] bg-slate-900">
                <img src="ache_render.jpg" alt="Air-Cooled Heat Exchanger Bundle Render" class="w-full h-full object-cover object-center opacity-90 hover:scale-105 transition-transform duration-700" onError="this.src='https://images.unsplash.com/photo-1581092160607-ee22621dd758?auto=format&fit=crop&w=1000&q=80'" />
                
                <div class="absolute inset-0 bg-gradient-to-t from-brand-dark-deep via-transparent to-transparent"></div>
                
                <div class="absolute top-4 left-4 glass-dark p-3 rounded-xl border border-white/10 flex items-center gap-3">
                  <div class="h-10 w-10 rounded-lg bg-brand-orange/20 text-brand-orange flex items-center justify-center font-bold">
                    <span class="material-symbols-outlined">verified</span>
                  </div>
                  <div>
                    <span class="block text-xs font-mono text-slate-400 uppercase">AVL Approved Vendor</span>
                    <span class="block text-sm font-display font-bold text-white">ASME &amp; API 661 Coded</span>
                  </div>
                </div>

                <div class="absolute bottom-4 left-4 right-4 glass-dark p-4 rounded-xl border border-white/10 flex items-center justify-between">
                  <div>
                    <span class="block text-xs font-mono text-brand-orange uppercase font-semibold">Chennai Engineering Works</span>
                    <span class="block text-sm font-display font-bold text-white">Plot No 305B, Kovur, Chennai</span>
                  </div>
                  <span class="material-symbols-outlined text-emerald-400 text-3xl">check_circle</span>
                </div>
              </div>
            </div>

            <div class="absolute -bottom-6 -right-6 w-36 h-36 bg-brand-orange/20 rounded-full blur-xl pointer-events-none"></div>
          </div>

        </div>

        <!-- KEY PERFORMANCE METRICS BAR -->
        <div class="absolute bottom-0 inset-x-0 bg-slate-900/95 border-t border-slate-800 backdrop-blur-xl py-6">
          <div class="max-w-7xl mx-auto px-4 lg:px-12 grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
            <div class="space-y-1">
              <span class="font-display font-extrabold text-3xl sm:text-4xl text-brand-orange">20+ Yrs</span>
              <span class="block font-mono text-xs text-slate-400 uppercase tracking-wider">Thermal Engineering Expertise</span>
            </div>
            <div class="space-y-1">
              <span class="font-display font-extrabold text-3xl sm:text-4xl text-brand-blue">100%</span>
              <span class="block font-mono text-xs text-slate-400 uppercase tracking-wider">AVL Coded Spares</span>
            </div>
            <div class="space-y-1">
              <span class="font-display font-extrabold text-3xl sm:text-4xl text-emerald-400">&lt; 24 Hrs</span>
              <span class="block font-mono text-xs text-slate-400 uppercase tracking-wider">Emergency Field Mobilization</span>
            </div>
            <div class="space-y-1">
